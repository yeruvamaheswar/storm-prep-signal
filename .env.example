ERCOT_USERNAME=
ERCOT_PASSWORD=
ERCOT_SUBSCRIPTION_KEY=
# Optional history. Put values in server/.env or the process env. Never in Vite.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Database password for DDL (CREATE TABLE). Not the Data API secret.
SUPABASE_DB_PASSWORD=
# Optional: only for a possible later add-on worker. Not used in Slices 0-6. Never required.
JEV_API_KEY=
RISK_MARGIN_PCT=15
LOOKAHEAD_HOURS=6
FETCH_TIMEOUT_S=3
# --live only: a newest posting older than this many minutes counts as no signal
STALE_AFTER_MIN=90
# Example simulation settings, not Base specs
FLEET_SIZE=100
HOME_KWH=25
HOME_MAX_KW=11.4
# Live/archive high call in MW. Unset scales the demo 0.40 peak with FLEET_SIZE (10k → 40 of 114).
# CALL_TARGET_MW=
HOME_START_SOC_MIN_PCT=45
HOME_START_SOC_MAX_PCT=75
BASE_RESERVE_PCT=30
STORM_RESERVE_PCT=60
# Simulation price bands for charge | hold | discharge intent. Not Base specs.
CHARGE_BELOW_USD=25
DISCHARGE_ABOVE_USD=60
TICK_MINUTES=5
# Simulated bad network for every tick, 0 to 1 (0 = clean). Tape "network" events override per tick.
CHANNEL_DROP_RATE=0
CHANNEL_DUP_RATE=0
CHANNEL_LATE_RATE=0
# Simulated battery feed (docs/agents/telemetry-vpp.md). 1 = on (default); 0 = plan from the simulator's truth.
# Example simulation values, not Base specs. Base says telemetry older than 180 s is stale.
TELEMETRY_FEED=1
TELEMETRY_EVERY_S=10
TELEMETRY_STALE_AFTER_S=180
TELEMETRY_DEAD_AFTER_S=600
# ERCOT's 4 load zones, each with one anchor county FIPS code (Harris, Dallas, Nueces, Midland)
ZONES=Houston:48201,North:48113,South:48355,West:48329
